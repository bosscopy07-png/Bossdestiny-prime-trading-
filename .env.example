# Bot
BOT_TOKEN=your_telegram_bot_token_here
ADMIN_IDS=123456789,987654321

# Exchange (bitget, binance, bybit, okx)
EXCHANGE_ID=bitget
EXCHANGE_API_KEY=optional
EXCHANGE_SECRET=optional
EXCHANGE_PASSPHRASE=optional_for_bitget
SANDBOX=false

# Challenge
CHALLENGE_START_CAPITAL=10
CHALLENGE_TARGET=100
CHALLENGE_DAYS=30
CURRENT_CAPITAL=10

# Risk
MAX_ACTIVE_TRADES=3
MAX_SIGNALS_PER_DAY=8
MIN_CONFIDENCE=60
MIN_RR=1.5
MAX_RISK_PER_TRADE_PCT=2
DAILY_LOSS_LIMIT_PCT=5
MAX_CONSECUTIVE_LOSSES=3
COOLDOWN_MINUTES_AFTER_LOSS_STREAK=30

# Scanning
SCAN_INTERVAL_MINUTES=240
TOP_VOLUME_COUNT=20
MIN_VOLUME_USD=5000000
AUTO_START_SCAN=false

# Referral
REFERRAL_LINK=https://bingx.com/invite/YOURCODE
REFERRAL_CODE=YOURCODE

# Logging
LOG_LEVEL=info
